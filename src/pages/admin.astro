      async function loadJobtrack() {
        const file = await getFile('src/data/checkins.json');
        state.jobtrack = { sha: file.sha, data: JSON.parse(file.text) };
        if (!state.jobtrack.data.activities) state.jobtrack.data.activities = [];
        if (!state.jobtrack.data.log) state.jobtrack.data.log = {};
        $('jt-date').value = today();
        renderCheckin();
        renderActivityManager();
        renderRecentLog();
      }
      const curDate = () => $('jt-date').value || today();
      function dayRecord() {
        const d = state.jobtrack.data.log;
        if (!d[curDate()]) d[curDate()] = {};
        return d[curDate()];
      }
      function setDayLabel() {
        const d = curDate();
        const t = today();
        const diff = Math.round((Date.parse(d) - Date.parse(t)) / 86400000);
        const wd = ['周日','周一','周二','周三','周四','周五','周六'][new Date(d + 'T00:00:00Z').getUTCDay()];
        $('jt-daylabel').textContent =
          diff === 0 ? `今天 · ${wd}` : diff === -1 ? `昨天 · ${wd}` : `${wd}`;
      }

      // 打卡卡片：计数型有 −/+ 步进，打卡型是一个大按钮
      function renderCheckin() {
        setDayLabel();
        const box = $('jt-cards');
        box.innerHTML = '';
        const rec = state.jobtrack.data.log[curDate()] || {};
        state.jobtrack.data.activities.forEach((a) => {
          const n = rec[a.id] || 0;
          const card = el('div', 'ci-card' + (n ? ' ci-on' : ''));
          card.style.setProperty('--ci', a.color);

          const head = el('div', 'ci-head');
          head.appendChild(el('span', 'ci-emoji', a.emoji));
          head.appendChild(el('span', 'ci-name', a.zh));
          card.appendChild(head);

          if (a.type === 'count') {
            const ctl = el('div', 'ci-stepper');
            const minus = el('button', 'step-btn', '−');
            minus.type = 'button';
            minus.addEventListener('click', () => bump(a.id, -1));
            const val = el('span', 'ci-value', String(n));
            const plus = el('button', 'step-btn step-plus', '+');
            plus.type = 'button';
            plus.addEventListener('click', () => bump(a.id, 1));
            ctl.append(minus, val, plus);
            card.appendChild(ctl);
          } else {
            const btn = el('button', 'ci-toggle', n ? '✓ 已完成' : '点一下打卡');
            btn.type = 'button';
            btn.addEventListener('click', () => bump(a.id, n ? -1 : 1, true));
            card.appendChild(btn);
          }
          box.appendChild(card);
        });
        if (!state.jobtrack.data.activities.length) {
          box.appendChild(el('p', 'admin-hint', '还没有打卡项目，点下面的「管理打卡项目」加一个吧。'));
        }
      }
      function bump(id, delta, isToggle) {
        const rec = dayRecord();
        const next = isToggle ? Math.max(0, delta > 0 ? 1 : 0) : Math.max(0, (rec[id] || 0) + delta);
        if (next === 0) delete rec[id];
        else rec[id] = next;
        if (!Object.keys(rec).length) delete state.jobtrack.data.log[curDate()];
        if (navigator.vibrate) navigator.vibrate(8);
        renderCheckin();
        queueSave();
      }
      // 改完 1.2 秒后自动保存，避免连点时反复提交
      function queueSave() {
        const msg = $('jt-msg');
        msg.textContent = '已记录，稍后自动保存…';
        msg.className = 'admin-msg jt-msg jt-pending';
        clearTimeout(saveTimer);
        saveTimer = setTimeout(async () => {
          msg.textContent = '保存中…';
          try {
            await saveCheckins(`Check-in: ${curDate()}`);
            msg.textContent = '✅ 已保存并发布，网站 1-2 分钟后更新';
            msg.className = 'admin-msg jt-msg jt-ok';
            renderRecentLog();
          } catch (e) {
            msg.textContent = '❌ ' + e.message;
            msg.className = 'admin-msg jt-msg jt-err';
          }
        }, 1200);
      }
      async function saveCheckins(message) {
        state.jobtrack.sha = await putFile(
          'src/data/checkins.json',
          JSON.stringify(state.jobtrack.data, null, 2) + '\n',
          message,
          state.jobtrack.sha
        );
      }
      function shiftDay(n) {
        const d = new Date(curDate() + 'T00:00:00Z');
        d.setUTCDate(d.getUTCDate() + n);
        $('jt-date').value = d.toISOString().slice(0, 10);
        renderCheckin();
      }
      $('jt-prev').addEventListener('click', () => shiftDay(-1));
      $('jt-next').addEventListener('click', () => shiftDay(1));
      $('jt-date').addEventListener('change', renderCheckin);

      function renderRecentLog() {
        const list = $('jt-list');
        list.innerHTML = '';
        const acts = state.jobtrack.data.activities;
        const entries = Object.entries(state.jobtrack.data.log).sort((a, b) => b[0].localeCompare(a[0])).slice(0, 14);
        if (!entries.length) return list.appendChild(el('li', 'bm-item-note', '还没有记录，从今天开始 💪'));
        entries.forEach(([date, rec]) => {
          const summary = acts
            .filter((a) => rec[a.id])
            .map((a) => `${a.emoji}${rec[a.id] > 1 ? '×' + rec[a.id] : ''}`)
            .join(' ');
          const li = el('li');
          const btn = el('button', 'file-btn', `${date}   ${summary}`);
          btn.type = 'button';
          btn.style.width = 'auto';
          btn.addEventListener('click', () => { $('jt-date').value = date; renderCheckin(); });
          li.appendChild(btn);
          const del = el('button', 'del-btn', '✕');
          del.type = 'button';
          del.addEventListener('click', async () => {
            if (!confirm(`删除 ${date} 的全部记录？`)) return;
            delete state.jobtrack.data.log[date];
            renderCheckin();
            await saveCheckins(`Remove check-in for ${date}`);
            renderRecentLog();
          });
          li.appendChild(del);
          list.appendChild(li);
        });
      }

      // ---- 打卡项目管理 ----
      function renderActivityManager() {
        const box = $('jt-act-list');
        box.innerHTML = '';
        state.jobtrack.data.activities.forEach((a, i) => {
          const card = el('div', 'act-row');
          const emoji = el('input', 'act-emoji');
          emoji.value = a.emoji;
          emoji.addEventListener('input', () => { a.emoji = emoji.value; });

          const zh = el('input', 'f-input act-name');
          zh.placeholder = '中文名，例：弹琴';
          zh.value = a.zh;
          zh.addEventListener('input', () => { a.zh = zh.value; a.id = a.id || slugify(zh.value); });

          const en = el('input', 'f-input act-name');
          en.placeholder = 'English, e.g. Piano';
          en.value = a.en;
          en.addEventListener('input', () => { a.en = en.value; });

          const type = el('select', 'f-input act-type');
          [['count', '计数（记数量）'], ['toggle', '打卡（做没做）']].forEach(([v, t]) => {
            const o = el('option', '', t);
            o.value = v;
            type.appendChild(o);
          });
          type.value = a.type;
          type.addEventListener('change', () => { a.type = type.value; renderCheckin(); });

          const color = el('input', 'act-color');
          color.type = 'color';
          color.value = a.color;
          color.addEventListener('input', () => { a.color = color.value; });

          const del = el('button', 'del-btn', '✕');
          del.type = 'button';
          del.addEventListener('click', () => {
            if (!confirm(`删除打卡项目「${a.zh}」？已有的历史记录不会被删除。`)) return;
            state.jobtrack.data.activities.splice(i, 1);
            renderActivityManager();
            renderCheckin();
          });

          card.append(emoji, zh, en, type, color, del);
          box.appendChild(card);
        });
      }
      const slugify = (s) =>
        (s || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') ||
        'act-' + Math.random().toString(36).slice(2, 7);

      $('btn-act-add').addEventListener('click', () => {
        const used = state.jobtrack.data.activities.length;
        state.jobtrack.data.activities.push({
          id: 'act-' + Math.random().toString(36).slice(2, 7),
          emoji: '⭐',
          zh: '',
          en: '',
          color: PALETTE[used % PALETTE.length],
          type: 'toggle',
        });
        renderActivityManager();
      });
      $('btn-act-save').addEventListener('click', async () => {
        const msg = $('act-msg');
        const acts = state.jobtrack.data.activities;
        for (const a of acts) {
          if (!a.zh.trim()) return (msg.textContent = '每个项目都要填中文名');
          if (!a.en.trim()) a.en = a.zh;
        }
        msg.textContent = '保存中…';
        try {
          await saveCheckins('Update check-in activities');
          renderCheckin();
          renderRecentLog();
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
      });

      init();
    </script>
  </body>
</html>
