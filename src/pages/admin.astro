      });
      $('btn-post-save').addEventListener('click', async () => {
        const cp = state.currentPost;
        if (!cp) return;
        const msg = $('post-msg');
        const data = {
          title: $('post-title').value.trim(),
          date: $('post-date').value || today(),
          lang: $('post-lang').value,
          summary: $('post-summary').value.trim(),
          tags: $('post-tags').value.split(/[,，]/).map((s) => s.trim()).filter(Boolean),
          featured: $('post-featured').checked,
          translation: $('post-translation').value,
          body: $('post-body').value,
        };
        if (!data.title) return (msg.textContent = '请先给文章起个标题');
        if (!data.body.trim()) return (msg.textContent = '正文还是空的');
        msg.textContent = '发布中…';
        $('btn-post-save').disabled = true;
        try {
          const sha = await putFile(cp.path, buildPost(data), (cp.isNew ? 'New post: ' : 'Update post: ') + data.title, cp.sha || undefined);
          Object.assign(cp, data, { sha, isNew: false });
          if (!state.posts.includes(cp)) state.posts.unshift(cp);
          state.posts.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
          renderPostList();
          $('btn-post-delete').hidden = false;
          $('btn-post-save').textContent = '保存修改并发布';
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
        $('btn-post-save').disabled = false;
      });
      $('btn-post-delete').addEventListener('click', async () => {
        const cp = state.currentPost;
        if (!cp || cp.isNew) return;
        if (!confirm(`确定要删除「${cp.title || '这篇文章'}」吗？删除后网站上就看不到了。`)) return;
        const msg = $('post-msg');
        msg.textContent = '删除中…';
        try {
          await deleteFile(cp.path, 'Delete post: ' + (cp.title || cp.path), cp.sha);
          state.posts = state.posts.filter((p) => p !== cp);
          state.currentPost = null;
          renderPostList();
          showPostForm(false);
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
      });

      // ============================================================
      // 🖼 图片上传：传到仓库 public/images/posts/，并把图片语法插入正文光标处
      // ============================================================
      $('btn-post-image').addEventListener('click', () => $('post-image-file').click());
      $('post-image-file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
