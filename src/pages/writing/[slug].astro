---
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 英文翻译（由编辑器里的 AI 翻译 + 审计功能生成），单次换行也渲染为换行
marked.setOptions({ breaks: true, gfm: true });
const translationHtml = post.data.translation ? marked.parse(post.data.translation) : null;
---

<Base title={post.data.title} description={post.data.summary} active="writing">
  <article>
    <header class="article-head">
      <p class="back-link">
        <a href="/writing/">
          <span class="lang-zh">← 返回文章列表</span>
          <span class="lang-en">← Back to writing</span>
        </a>
      </p>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span>{fmt(post.data.date)}</span>
        <span class="badge badge-lang">{post.data.lang === 'zh' ? '中文' : 'EN'}</span>
        {translationHtml && <span class="badge badge-lang">双语 Bilingual</span>}
        {post.data.tags.map((t) => <a class="badge badge-tag" href={`/writing/tag/${encodeURIComponent(t)}/`}>#{t}</a>)}
      </div>
    </header>

    {
      translationHtml ? (
        <div class="article-bilingual">
          <div>
            <p class="column-label">原文 · Original</p>
            <div class="prose">
              <Content />
            </div>
          </div>
          <div>
            <p class="column-label">English · AI-translated & audited</p>
            <div class="prose prose-translation" set:html={translationHtml} />
          </div>
        </div>
      ) : (
        <div class="prose">
          <Content />
        </div>
      )
    }
  </article>
</Base>
