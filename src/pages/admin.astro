      }
      $('btn-post-new').addEventListener('click', () => {
        const stamp = new Date();
        const pad = (n) => String(n).padStart(2, '0');
        const slug = `note-${stamp.getFullYear()}${pad(stamp.getMonth() + 1)}${pad(stamp.getDate())}-${pad(stamp.getHours())}${pad(stamp.getMinutes())}`;
        state.currentPost = { path: `src/content/posts/${slug}.md`, sha: null, isNew: true };
