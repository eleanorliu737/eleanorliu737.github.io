        if (!file) return;
        const msg = $('post-msg');
        if (file.size > 8 * 1024 * 1024) return (msg.textContent = '❌ 图片超过 8MB，请压缩后再上传（手机截图一般没问题）');
        msg.textContent = '图片上传中…';
        try {
          const bytes = new Uint8Array(await file.arrayBuffer());
          const b64 = bytesToB64(bytes);
          let ext = (file.name.split('.').pop() || 'png').toLowerCase().replace(/[^a-z0-9]/g, '');
          if (!ext) ext = 'png';
          const stamp = new Date().toISOString().replace(/[-:TZ.]/g, '').slice(0, 14);
          const path = `public/images/posts/img-${stamp}.${ext}`;
          await putFileRaw(path, b64, `Upload image: img-${stamp}.${ext}`);
          const ta = $('post-body');
          const snippet = `\n![图片描述](/images/posts/img-${stamp}.${ext})\n`;
          const pos = ta.selectionStart ?? ta.value.length;
          ta.value = ta.value.slice(0, pos) + snippet + ta.value.slice(pos);
          msg.textContent = '✅ 图片已上传并插入正文。「图片描述」几个字可以改成对图片的说明。';
        } catch (err) {
          msg.textContent = '❌ ' + err.message;
        }
      });

      // ============================================================
      // 🌐 AI 翻译 + 意义损失审计（浏览器直接调用 Claude API）
      // ============================================================
      const TRANSLATE_SYSTEM = [
        '你是一位专业的中译英译者，正在翻译一位作者的个人博客文章。',
        '流程：',
        '1. 将文章翻译成自然、地道的英文，保留作者的个人语气和全部 Markdown 格式（标题、列表、加粗、链接、图片）。',
        '2. 对译文做「意义损失审计」：逐段对照原文，检查漏译、误译、语气偏移、文化语境丢失、歧义引入。',
        '3. 根据审计结果修订译文，输出最终版本。',
        '输出 JSON：translation = 修订后的英文全文（Markdown）；audit = 简短的中文审计报告（3-6 条要点：发现了什么问题、如何处理、哪些中文韵味无法完全传达）。',
      ].join('\n');

      $('btn-apikey-save').addEventListener('click', () => {
        const k = $('apikey-input').value.trim();
        if (!k) return;
        localStorage.setItem('anthropic-key', k);
        $('apikey-row').hidden = true;
        translatePost();
      });
      $('btn-translate').addEventListener('click', translatePost);
      async function translatePost() {
        const audit = $('trans-audit');
        const key = localStorage.getItem('anthropic-key');
        if (!key) {
          $('apikey-row').hidden = false;
          audit.hidden = false;
          audit.textContent = '首次使用需要一个 Claude API Key（在 console.anthropic.com → API Keys 创建），填入下方并保存。Key 只存在这台浏览器里。';
          return;
        }
        const bodyText = $('post-body').value;
        if (!bodyText.trim()) {
          audit.hidden = false;
          audit.textContent = '正文还是空的，先写点东西再翻译。';
          return;
        }
        const btn = $('btn-translate');
        btn.disabled = true;
        btn.textContent = '翻译并审计中…（约 1-2 分钟）';
        audit.hidden = false;
        audit.textContent = 'AI 正在翻译 → 审计意义损失 → 修订译文……';
        try {
          const r = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              'x-api-key': key,
              'anthropic-version': '2023-06-01',
              'anthropic-dangerous-direct-browser-access': 'true',
            },
            body: JSON.stringify({
              model: 'claude-opus-5',
              max_tokens: 16000,
              system: TRANSLATE_SYSTEM,
              output_config: {
                format: {
                  type: 'json_schema',
                  schema: {
                    type: 'object',
                    properties: { translation: { type: 'string' }, audit: { type: 'string' } },
                    required: ['translation', 'audit'],
                    additionalProperties: false,
                  },
                },
              },
              messages: [
                {
                  role: 'user',
                  content: `文章标题：${$('post-title').value}\n\n正文（Markdown）：\n\n${bodyText}`,
                },
              ],
            }),
          });
          if (!r.ok) {
            const j = await r.json().catch(() => ({}));
            if (r.status === 401) {
              localStorage.removeItem('anthropic-key');
              throw new Error('API Key 无效或已过期，请重新填写');
            }
            throw new Error('翻译请求失败（HTTP ' + r.status + (j.error && j.error.message ? '：' + j.error.message : '') + '）');
          }
          const j = await r.json();
          if (j.stop_reason === 'refusal') throw new Error('模型拒绝了这次请求，请调整内容后重试');
          const textBlock = (j.content || []).find((b) => b.type === 'text');
          if (!textBlock) throw new Error('没有收到翻译结果，请重试');
          const parsed = JSON.parse(textBlock.text);
          $('post-translation').value = parsed.translation;
          audit.textContent = '🔍 翻译审计报告（确认无误后点「保存/发布」，翻译才会上线）：\n\n' + parsed.audit;
        } catch (err) {
          audit.textContent = '❌ ' + err.message;
        }
        btn.disabled = false;
        btn.textContent = '✨ AI 翻译 + 审计';
      }

      // ============================================================
      // 📚 收藏
      // ============================================================
      async function loadBookmarks() {
