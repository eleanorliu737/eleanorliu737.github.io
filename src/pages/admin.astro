---
// 站内编辑器（Eleanor Login）：/admin/
// 面向不写代码的使用者：所有内容都通过表单编辑，不暴露任何代码格式。
// 原理：保存时用仅限本仓库的 GitHub 令牌直接向仓库提交修改（等于自动 commit+push），
// 网站随后自动重新构建发布。令牌用你的密码加密后存在 public/admin-vault.json，
// 密码与明文令牌只存在于你的浏览器里。
import '../styles/global.css';

const OWNER = 'eleanorliu737';
const REPO = 'eleanorliu737.github.io';
const BRANCH = 'main';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Eleanor Login · 站点编辑</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✏️</text></svg>"
    />
  </head>
  <body>
    <main class="site-main admin-main">
      <header class="admin-header">
        <a class="admin-logo" href="/">Eleanor<span class="logo-dot">.</span>Liu</a>
        <span class="admin-tag">✏️ 编辑模式</span>
        <button id="btn-logout" class="admin-btn ghost" type="button" hidden>退出登录</button>
      </header>

      <section id="view-loading">
        <p class="admin-msg">加载中…</p>
      </section>

      <section id="view-setup" class="admin-card" hidden>
        <h1>首次配置</h1>
        <p class="admin-hint">
          还没有设置过编辑密码。请粘贴你的 GitHub 令牌，并设置一个今后登录用的密码。
          令牌会以加密形式存入仓库；<strong>密码和明文令牌不会离开你的浏览器</strong>。
        </p>
        <label>GitHub 令牌 <input id="setup-token" type="password" placeholder="github_pat_..." autocomplete="off" /></label>
        <label>设置密码（建议 12 位以上，越长越安全） <input id="setup-pass" type="password" autocomplete="new-password" /></label>
        <label>确认密码 <input id="setup-pass2" type="password" autocomplete="new-password" /></label>
        <button id="btn-setup" class="admin-btn" type="button">加密并保存</button>
        <p id="setup-msg" class="admin-msg"></p>
      </section>

      <section id="view-login" class="admin-card" hidden>
        <h1>Eleanor Login</h1>
        <label>密码 <input id="login-pass" type="password" autocomplete="current-password" /></label>
        <button id="btn-login" class="admin-btn" type="button">进入编辑</button>
        <p id="login-msg" class="admin-msg"></p>
        <p class="admin-hint"><button id="btn-reset" class="link-btn" type="button">忘记密码？用新令牌重新配置</button></p>
      </section>

      <section id="view-editor" hidden>
        <p class="editor-tip">💡 在这里做的任何修改，点「发布」之后网站会在 <strong>1-2 分钟</strong>内自动更新（刷新网站页面即可看到）。</p>

        <nav class="tab-bar">
          <button class="tab-btn active" type="button" data-tab="posts">📝 写文章</button>
          <button class="tab-btn" type="button" data-tab="bookmarks">📚 收藏好文章</button>
          <button class="tab-btn" type="button" data-tab="journey">🧭 人生轨迹</button>
          <button class="tab-btn" type="button" data-tab="works">🛠 作品与想法</button>
          <button class="tab-btn" type="button" data-tab="jobtrack">🎯 求职打卡</button>
        </nav>

        <!-- ============ 文章 ============ -->
        <div id="tab-posts" class="tab-panel">
          <div class="posts-grid">
            <aside>
              <button id="btn-post-new" class="admin-btn wide" type="button">➕ 写一篇新的</button>
              <p class="side-caption">已发表的文章（点击可修改）：</p>
              <ul id="post-list" class="post-picker"><li class="side-caption">读取中…</li></ul>
            </aside>
            <div id="post-form" class="form-panel" hidden>
              <label class="f-field"><span class="f-label">标题</span>
                <input id="post-title" class="f-input" type="text" placeholder="给这篇文章起个标题" />
              </label>
              <div class="f-row">
                <label class="f-field"><span class="f-label">日期</span>
                  <input id="post-date" class="f-input" type="date" />
                </label>
                <label class="f-field"><span class="f-label">这篇文章是什么语言写的？</span>
                  <select id="post-lang" class="f-input">
                    <option value="zh">中文</option>
                    <option value="en">English</option>
                  </select>
                </label>
              </div>
              <label class="f-field"><span class="f-label">一句话摘要（显示在文章列表里）</span>
                <input id="post-summary" class="f-input" type="text" placeholder="可以先空着，之后再补" />
              </label>
              <label class="f-field"><span class="f-label">标签（用逗号分开）</span>
                <input id="post-tags" class="f-input" type="text" placeholder="例如：随手记, 生活" />
              </label>
              <div class="body-toolbar">
                <span class="f-label">正文</span>
                <button id="btn-post-image" class="admin-btn ghost small" type="button">🖼 插入图片</button>
                <input id="post-image-file" type="file" accept="image/*" hidden />
              </div>
              <textarea id="post-body" class="f-input f-body" placeholder="直接打字就行，写出来什么样、发布后就显示什么样。&#10;&#10;换行 = 换行显示。&#10;行首写「## 」 = 小标题。&#10;两个星号包住文字 = **加粗**。&#10;插入图片请用上面的「🖼 插入图片」按钮。"></textarea>
              <label class="f-check">
                <input type="checkbox" id="post-featured" /> 🏠 在首页「精选文章」里显示这篇
              </label>
              <div class="trans-box">
                <div class="trans-head">
                  <span class="f-label">🌐 英文翻译（有翻译时，文章页会左右对照显示）</span>
                  <button id="btn-translate" class="admin-btn ghost small" type="button">✨ AI 翻译 + 审计</button>
                </div>
                <textarea
                  id="post-translation"
                  class="f-input"
                  placeholder="点上面的按钮自动翻译（会先翻译、再逐段审计意义损失、再修订）。结果可以手动修改；留空则文章只显示原文。"
                ></textarea>
                <p id="trans-audit" class="trans-audit" hidden></p>
                <div id="apikey-row" hidden>
                  <label class="f-field"><span class="f-label">Claude API Key（只保存在本浏览器；在 console.anthropic.com 创建）</span>
                    <input id="apikey-input" class="f-input" type="password" placeholder="sk-ant-..." autocomplete="off" />
                  </label>
                  <button id="btn-apikey-save" class="admin-btn small" type="button">保存 Key 并继续</button>
                </div>
              </div>
              <div class="form-actions">
                <button id="btn-post-save" class="admin-btn" type="button">发布这篇文章</button>
                <button id="btn-post-delete" class="admin-btn danger" type="button" hidden>删除这篇文章</button>
              </div>
              <p id="post-msg" class="admin-msg"></p>
            </div>
            <div id="post-empty" class="form-panel empty-hint">
              <p>👈 点左边的「➕ 写一篇新的」开始记录，<br />或者点击一篇已有的文章进行修改。</p>
            </div>
          </div>
        </div>

        <!-- ============ 收藏 ============ -->
        <div id="tab-bookmarks" class="tab-panel" hidden>
          <div class="form-panel add-box">
            <p class="box-title">📥 收藏一篇好文章</p>
            <label class="f-field"><span class="f-label">放进哪个收藏夹？</span>
              <select id="bm-folder" class="f-input"></select>
            </label>
            <div id="bm-newfolder" hidden>
              <div class="f-row">
                <label class="f-field f-narrow"><span class="f-label">收藏夹图标（一个 emoji）</span>
                  <input id="bm-nf-emoji" class="f-input" type="text" value="🔖" />
                </label>
                <label class="f-field"><span class="f-label">新收藏夹的名字</span>
                  <input id="bm-nf-name" class="f-input" type="text" placeholder="例如：读书笔记" />
                </label>
              </div>
              <label class="f-field"><span class="f-label">一句话介绍这个收藏夹（可空）</span>
                <input id="bm-nf-blurb" class="f-input" type="text" />
              </label>
            </div>
            <label class="f-field"><span class="f-label">文章标题</span>
              <input id="bm-title" class="f-input" type="text" placeholder="这篇文章叫什么" />
            </label>
            <label class="f-field"><span class="f-label">网址（直接从浏览器地址栏复制过来）</span>
              <input id="bm-url" class="f-input" type="text" placeholder="https://..." />
            </label>
            <label class="f-field"><span class="f-label">推荐语：为什么值得读？（可空）</span>
              <input id="bm-note" class="f-input" type="text" />
            </label>
            <div class="form-actions">
              <button id="btn-bm-add" class="admin-btn" type="button">收藏并发布</button>
            </div>
            <p id="bm-msg" class="admin-msg"></p>
          </div>
          <p class="side-caption">已有的收藏（点 ✕ 可删除）：</p>
          <div id="bm-folders"></div>
        </div>

        <!-- ============ 轨迹 ============ -->
        <div id="tab-journey" class="tab-panel" hidden>
          <p class="side-caption">「轨迹」页上的人生章节，从上到下按顺序显示。中文版和英文版分别显示给选了对应语言的访客。</p>
          <div id="jo-list"></div>
          <div class="form-actions">
            <button id="btn-jo-add" class="admin-btn ghost" type="button">➕ 添加一个新章节</button>
            <button id="btn-jo-save" class="admin-btn" type="button">发布轨迹页的修改</button>
          </div>
          <p id="jo-msg" class="admin-msg"></p>
        </div>

        <!-- ============ 作品 ============ -->
        <div id="tab-works" class="tab-panel" hidden>
          <p class="box-title">🛠 做出来的作品</p>
          <div id="wk-projects"></div>
          <button id="btn-wk-addp" class="admin-btn ghost small" type="button">➕ 添加一个作品</button>
          <p class="box-title" style="margin-top:2rem">💡 冒泡中的想法</p>
          <div id="wk-ideas"></div>
          <button id="btn-wk-addi" class="admin-btn ghost small" type="button">➕ 添加一个想法</button>
          <div class="form-actions">
            <button id="btn-wk-save" class="admin-btn" type="button">发布作品页的修改</button>
          </div>
          <p id="wk-msg" class="admin-msg"></p>
        </div>

        <!-- ============ 求职打卡 ============ -->
        <div id="tab-jobtrack" class="tab-panel" hidden>
          <div class="form-panel add-box">
            <p class="box-title">🎯 记录一天的求职进展</p>
            <p class="admin-hint">记录会显示在网站「轨迹」页底部的求职足迹日历上。</p>
            <div class="f-row">
              <label class="f-field f-narrow"><span class="f-label">日期</span>
                <input id="jt-date" type="date" class="f-input" />
              </label>
              <label class="f-field f-narrow"><span class="f-label">投出简历（份）</span>
                <input id="jt-applied" type="number" min="0" class="f-input" value="0" />
              </label>
              <label class="f-field f-narrow"><span class="f-label">收到回复（个）</span>
                <input id="jt-replies" type="number" min="0" class="f-input" value="0" />
              </label>
            </div>
            <label class="f-check"><input type="checkbox" id="jt-interview" /> 📞 这天收到或参加了面试</label>
            <div class="form-actions">
              <button id="btn-jt-save" class="admin-btn" type="button">记录并发布</button>
            </div>
            <p id="jt-msg" class="admin-msg"></p>
          </div>
          <p class="side-caption">已有记录（点日期可修改，✕ 删除）：</p>
          <ul id="jt-list" class="bm-items"></ul>
        </div>
      </section>
    </main>

    <style is:global>
      /* is:global 是必须的：编辑器界面大量由 JS 动态生成，
         Astro 默认的组件作用域样式对动态元素不生效 */
      .admin-main { padding-top: 1.5rem; }
      .admin-header { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
      .admin-logo { font-family: var(--mono); font-weight: 700; font-size: 1.05rem; color: var(--ink); }
      .admin-logo:hover { text-decoration: none; color: var(--accent); }
      .admin-tag {
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em;
        color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.1rem 0.6rem;
      }
      #btn-logout { margin-left: auto; margin-top: 0; }

      .admin-card { max-width: 28rem; }
      .admin-card h1 { font-size: 1.5rem; }
      .admin-card label { display: block; margin: 1rem 0 0; font-size: 0.9rem; color: var(--muted); }
      .admin-card input {
        display: block; width: 100%; margin-top: 0.35rem; padding: 0.55rem 0.7rem;
        font-family: var(--mono); font-size: 0.95rem; color: var(--ink);
        background: var(--bg-card); border: 1px solid var(--line); border-radius: 8px; box-sizing: border-box;
      }
      .admin-card input:focus { outline: none; border-color: var(--accent); }

      .admin-btn {
        margin-top: 1rem; padding: 0.5rem 1.2rem; font-size: 0.95rem; font-family: inherit;
        color: #fff; background: var(--accent); border: none; border-radius: 8px; cursor: pointer;
      }
      .admin-btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .admin-btn.small { font-size: 0.85rem; padding: 0.35rem 0.8rem; }
      .admin-btn.wide { width: 100%; margin-top: 0; }
      .admin-btn.ghost { background: none; color: var(--accent); border: 1px dashed var(--accent); }
      .admin-btn.danger { background: none; color: #c0392b; border: 1px solid #c0392b; }
      .link-btn { background: none; border: none; padding: 0; color: var(--accent); cursor: pointer; font: inherit; font-size: 0.85rem; }

      .admin-msg { color: var(--muted); font-size: 0.9rem; min-height: 1.4em; margin: 0.8rem 0 0; white-space: pre-line; }
      .admin-hint { color: var(--muted); font-size: 0.9rem; line-height: 1.7; }

      .editor-tip {
        background: var(--accent-soft); border-radius: 10px; padding: 0.7rem 1rem;
        font-size: 0.9rem; color: var(--ink); margin: 0 0 1.2rem;
      }

      .tab-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 2px solid var(--line); margin-bottom: 1.5rem; }
      .tab-btn {
        background: none; border: none; cursor: pointer; font: inherit; font-size: 0.98rem;
        padding: 0.5rem 0.9rem; color: var(--muted); border-bottom: 3px solid transparent; margin-bottom: -2px;
      }
      .tab-btn.active { color: var(--ink); font-weight: 600; border-bottom-color: var(--accent); }

      .posts-grid { display: grid; grid-template-columns: 17rem 1fr; gap: 2rem; align-items: start; }
      @media (max-width: 800px) { .posts-grid { grid-template-columns: 1fr; } }

      .side-caption { font-size: 0.85rem; color: var(--muted); margin: 1rem 0 0.5rem; }
      .post-picker { list-style: none; margin: 0; padding: 0; }
      .post-picker li { margin: 0.2rem 0; }
      .post-pick-btn {
        display: block; width: 100%; text-align: left; background: none; border: 1px solid transparent;
        padding: 0.45rem 0.6rem; border-radius: 8px; color: var(--ink); cursor: pointer; font: inherit; font-size: 0.9rem;
      }
      .post-pick-btn:hover { background: var(--accent-soft); }
      .post-pick-btn.active { border-color: var(--accent); background: var(--accent-soft); }
      .post-pick-meta { display: block; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-top: 0.15rem; }

      .form-panel { min-width: 0; }
      .empty-hint { color: var(--muted); padding-top: 2rem; line-height: 2; }
      .add-box { background: var(--bg-card); border: 1px solid var(--line); border-radius: 12px; padding: 1.2rem 1.4rem 1.4rem; max-width: 36rem; }
      .box-title { font-weight: 600; font-size: 1.05rem; margin: 0 0 0.4rem; }

      .f-field { display: block; margin: 0.9rem 0 0; min-width: 0; flex: 1; }
      .f-label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.3rem; }
      .f-input {
        display: block; width: 100%; padding: 0.5rem 0.7rem; box-sizing: border-box;
        font: inherit; font-size: 0.95rem; color: var(--ink);
        background: var(--bg-card); border: 1px solid var(--line); border-radius: 8px;
      }
      .f-input:focus { outline: none; border-color: var(--accent); }
      textarea.f-input { min-height: 6rem; line-height: 1.7; resize: vertical; }
      .f-body { min-height: 45vh; }
      .f-row { display: flex; gap: 1rem; flex-wrap: wrap; }
      .f-narrow { flex: 0 0 11rem; }
      .form-actions { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }

      .body-toolbar { display: flex; align-items: center; justify-content: space-between; margin: 0.9rem 0 0.3rem; }
      .body-toolbar .admin-btn { margin-top: 0; }
      .f-check { display: flex; align-items: center; gap: 0.5rem; margin: 0.9rem 0 0; font-size: 0.92rem; cursor: pointer; }
      .f-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--accent); }

      .trans-box { margin-top: 1.1rem; border: 1px dashed var(--line); border-radius: 10px; padding: 0.9rem 1rem 1rem; }
      .trans-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
      .trans-head .admin-btn { margin-top: 0; }
      .trans-box textarea { min-height: 10rem; }
      .trans-audit {
        white-space: pre-line; background: var(--accent-soft); border-radius: 8px;
        padding: 0.7rem 0.9rem; font-size: 0.88rem; margin: 0.7rem 0 0; color: var(--ink);
      }

      .item-card {
        background: var(--bg-card); border: 1px solid var(--line); border-radius: 12px;
        padding: 0.9rem 1.2rem 1.2rem; margin: 1rem 0; position: relative;
      }
      .item-card-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      .item-card-title { font-weight: 600; font-size: 0.95rem; color: var(--muted); }
      .del-btn {
        background: none; border: none; cursor: pointer; color: var(--muted); font-size: 0.85rem; padding: 0.2rem 0.4rem;
      }
      .del-btn:hover { color: #c0392b; }

      .bm-folder-block { margin: 1.2rem 0; }
      .bm-folder-name { font-weight: 600; margin: 0 0 0.3rem; }
      .bm-items { list-style: none; margin: 0; padding: 0; }
      .bm-items li {
        display: flex; align-items: baseline; gap: 0.6rem; padding: 0.4rem 0;
        border-bottom: 1px dashed var(--line); font-size: 0.92rem;
      }
      .bm-item-note { color: var(--muted); font-size: 0.85rem; flex: 1; }
    </style>

    <script define:vars={{ OWNER, REPO, BRANCH }}>
      const API = 'https://api.github.com';
      const VAULT_PATH = 'public/admin-vault.json';
      const enc = new TextEncoder();
      const $ = (id) => document.getElementById(id);
      const views = ['view-loading', 'view-setup', 'view-login', 'view-editor'];

      let token = localStorage.getItem('admin-token') || '';
      const state = {
        posts: [],
        currentPost: null,
        bookmarks: null,
        journey: null,
        works: null,
        dirty: { journey: false, works: false },
        loaded: {},
      };

      function show(view) {
        views.forEach((v) => ($(v).hidden = v !== view));
        $('btn-logout').hidden = view !== 'view-editor';
      }
      function el(tag, cls, text) {
        const e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text !== undefined) e.textContent = text;
        return e;
      }
      function field(labelText, value, onInput, opts = {}) {
        const wrap = el('label', 'f-field' + (opts.narrow ? ' f-narrow' : ''));
        wrap.appendChild(el('span', 'f-label', labelText));
        const input = opts.textarea ? el('textarea', 'f-input') : el('input', 'f-input');
        if (!opts.textarea) input.type = 'text';
        input.value = value || '';
        if (opts.placeholder) input.placeholder = opts.placeholder;
        input.addEventListener('input', () => onInput(input.value));
        wrap.appendChild(input);
        return wrap;
      }
      function row(...children) {
        const r = el('div', 'f-row');
        children.forEach((c) => r.appendChild(c));
        return r;
      }
      const today = () => new Date().toISOString().slice(0, 10);

      // ---------- base64 / 加密工具 ----------
      function bytesToB64(bytes) {
        let bin = '';
        new Uint8Array(bytes).forEach((b) => (bin += String.fromCharCode(b)));
        return btoa(bin);
      }
      function b64ToBytes(b64) {
        const bin = atob(b64.replace(/\s/g, ''));
        return Uint8Array.from(bin, (c) => c.charCodeAt(0));
      }
      const utf8ToB64 = (str) => bytesToB64(enc.encode(str));
      const b64ToUtf8 = (b64) => new TextDecoder().decode(b64ToBytes(b64));

      async function deriveKey(pass, salt, iter) {
        const km = await crypto.subtle.importKey('raw', enc.encode(pass), 'PBKDF2', false, ['deriveKey']);
        return crypto.subtle.deriveKey(
          { name: 'PBKDF2', salt, iterations: iter, hash: 'SHA-256' },
          km,
          { name: 'AES-GCM', length: 256 },
          false,
          ['encrypt', 'decrypt']
        );
      }
      async function encryptToken(tok, pass) {
        const salt = crypto.getRandomValues(new Uint8Array(16));
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const iter = 600000;
        const key = await deriveKey(pass, salt, iter);
        const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, enc.encode(tok));
        return { v: 1, kdf: 'PBKDF2-SHA256', iter, salt: bytesToB64(salt), iv: bytesToB64(iv), ct: bytesToB64(ct) };
      }
      async function decryptToken(vault, pass) {
        const key = await deriveKey(pass, b64ToBytes(vault.salt), vault.iter);
        const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64ToBytes(vault.iv) }, key, b64ToBytes(vault.ct));
        return new TextDecoder().decode(pt);
      }

      // ---------- GitHub API ----------
      function gh(path, opts = {}) {
        return fetch(API + path, {
          ...opts,
          headers: {
            Authorization: 'Bearer ' + token,
            Accept: 'application/vnd.github+json',
            ...(opts.headers || {}),
          },
        });
      }
      async function tokenValid() {
        if (!token) return false;
        try {
          const r = await gh(`/repos/${OWNER}/${REPO}`);
          return r.ok;
        } catch (e) {
          return false;
        }
      }
      async function loadVault() {
        const urls = [
          `/admin-vault.json?t=${Date.now()}`,
          `https://raw.githubusercontent.com/${OWNER}/${REPO}/${BRANCH}/public/admin-vault.json?t=${Date.now()}`,
        ];
        for (const url of urls) {
          try {
            const r = await fetch(url, { cache: 'no-store' });
            if (r.ok) return await r.json();
          } catch (e) {}
        }
        return null;
      }
      async function getFile(path) {
        const r = await gh(`/repos/${OWNER}/${REPO}/contents/${path}?ref=${BRANCH}&t=${Date.now()}`);
        if (!r.ok) throw new Error('读取失败（HTTP ' + r.status + '）');
        const j = await r.json();
        return { text: b64ToUtf8(j.content), sha: j.sha };
      }
      async function putFileRaw(path, contentB64, message, sha) {
        const body = { message, branch: BRANCH, content: contentB64 };
        if (sha) body.sha = sha;
        const r = await gh(`/repos/${OWNER}/${REPO}/contents/${path}`, { method: 'PUT', body: JSON.stringify(body) });
        if (!r.ok) {
          const j = await r.json().catch(() => ({}));
          throw new Error('上传失败（HTTP ' + r.status + (j.message ? '：' + j.message : '') + '）');
        }
        return (await r.json()).content.sha;
      }
      async function putFile(path, text, message, sha) {
        const body = { message, branch: BRANCH, content: utf8ToB64(text) };
        if (sha) body.sha = sha;
        const r = await gh(`/repos/${OWNER}/${REPO}/contents/${path}`, { method: 'PUT', body: JSON.stringify(body) });
        if (!r.ok) {
          const j = await r.json().catch(() => ({}));
          throw new Error('保存失败（HTTP ' + r.status + (j.message ? '：' + j.message : '') + '）');
        }
        return (await r.json()).content.sha;
      }
      async function deleteFile(path, message, sha) {
        const r = await gh(`/repos/${OWNER}/${REPO}/contents/${path}`, {
          method: 'DELETE',
          body: JSON.stringify({ message, branch: BRANCH, sha }),
        });
        if (!r.ok) throw new Error('删除失败（HTTP ' + r.status + '）');
      }
      const OK_MSG = '✅ 已发布！网站会在 1-2 分钟后自动更新。';

      // ---------- 登录 / 配置流程 ----------
