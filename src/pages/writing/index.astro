---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);

// ---- 标签入口 ----
const tagCounts: Record<string, number> = {};
posts.forEach((p) => p.data.tags.forEach((t) => (tagCounts[t] = (tagCounts[t] || 0) + 1)));
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base title="文章 Writing" active="writing">
  <p class="kicker">03 · Writing</p>
  <h1><span class="lang-zh">文章</span><span class="lang-en">Writing</span></h1>
  <p class="lede lang-zh">做自己的 journalist：不追热点，只发表自己真正想清楚了的东西。</p>
  <p class="lede lang-en">Being my own journalist — publishing only what I've actually thought through.</p>

  <section class="tag-entries">
    <h2><span class="lang-zh">分类入口</span><span class="lang-en">Browse by topic</span></h2>
    <div class="tag-chips">
      {
        tags.map(([t, n]) => (
          <a class="tag-chip" href={`/writing/tag/${encodeURIComponent(t)}/`}>
            #{t} <span class="tag-count">{n}</span>
          </a>
        ))
      }
    </div>
  </section>

  <h2><span class="lang-zh">全部文章</span><span class="lang-en">All posts</span></h2>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="post-title" href={`/writing/${post.id}/`}>{post.data.title}</a>
          <div class="post-meta">
            <span>{fmt(post.data.date)}</span>
            <span class="badge badge-lang">{post.data.lang === 'zh' ? '中文' : 'EN'}</span>
            {post.data.translation && <span class="badge badge-lang">双语</span>}
            {post.data.tags.map((t) => (
              <a class="badge badge-tag" href={`/writing/tag/${encodeURIComponent(t)}/`}>#{t}</a>
            ))}
          </div>
          {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
        </li>
      ))
    }
  </ul>
</Base>
