      function itemCard(titleText, obj, fields, which, onDelete) {
        const card = el('div', 'item-card');
        const head = el('div', 'item-card-head');
        head.appendChild(el('span', 'item-card-title', titleText));
        const del = el('button', 'del-btn', '✕ 删除');
        del.type = 'button';
        del.addEventListener('click', onDelete);
        head.appendChild(del);
        card.appendChild(head);
        let pendingRow = [];
        fields.forEach(([key, label, opts = {}]) => {
          const f = field(label, obj[key], (v) => { obj[key] = v; markDirty(which); }, opts);
          if (opts.narrow && pendingRow.length === 0) {
            pendingRow.push(f);
          } else if (pendingRow.length) {
            card.appendChild(row(...pendingRow, f));
            pendingRow = [];
          } else {
            card.appendChild(f);
          }
        });
        pendingRow.forEach((f) => card.appendChild(f));
        return card;
      }
