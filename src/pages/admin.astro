        $('post-featured').checked = !!p.featured;
        $('post-translation').value = p.translation || '';
        $('trans-audit').hidden = true;
        $('btn-post-delete').hidden = false;
        $('btn-post-save').textContent = '保存修改并发布';
        $('post-msg').textContent = '';
