      // 打开一篇文章时，如果本机存着更新的草稿，问要不要恢复
      function offerDraftRestore(path) {
        let d;
        try { d = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); } catch (e) { return; }
        if (!d || d.path !== path || d.body === $('post-body').value) return;
        const when = new Date(d.at).toLocaleString('zh-CN', { hour12: false }).slice(5, 16);
        if (confirm(`本机存有 ${when} 的未发布草稿，要恢复吗？\n（选取消则继续用已发布的版本）`)) {
          $('post-title').value = d.title;
