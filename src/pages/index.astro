---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import folders from '../data/bookmarks.json';
import jobtrackData from '../data/jobtrack.json';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// 首页只显示勾选了「在首页显示」的文章；一篇都没勾时退回显示最新 3 篇
const featured = all.filter((p) => p.data.featured);
const hasFeatured = featured.length > 0;
const posts = (hasFeatured ? featured : all).slice(0, 6);

const fmt = (d: Date) => d.toISOString().slice(0, 10);

// ============================================================
// 统一动态日历（GitHub 贡献图风格）：自 2026-07 起的所有站内动态
// ============================================================
interface DayRecord {
  applied?: number;
  replies?: number;
  interview?: boolean;
  project?: boolean;
  study?: boolean;
}
const track: Record<string, DayRecord> = jobtrackData as any;

const postCount: Record<string, number> = {};
all.forEach((p) => {
  const d = fmt(p.data.date);
  postCount[d] = (postCount[d] || 0) + 1;
});
const bmCount: Record<string, number> = {};
(folders as any[]).forEach((f) =>
  f.items.forEach((it: any) => {
    if (it.date) bmCount[it.date] = (bmCount[it.date] || 0) + 1;
  })
);

const CATS: Record<string, { color: string; zh: string; en: string }> = {
  post: { color: '#e8590c', zh: '发表文章', en: 'Writing' },
  bookmark: { color: '#fab005', zh: '收藏好文', en: 'Bookmarks' },
  applied: { color: '#4dabf7', zh: '投简历', en: 'Applications' },
  interview: { color: '#7048e8', zh: '面试', en: 'Interviews' },
  project: { color: '#2f9e44', zh: '做项目', en: 'Projects' },
  study: { color: '#f06595', zh: '学习', en: 'Learning' },
};

function dayActivities(key: string) {
  const acts: { c: string; n: number }[] = [];
  if (postCount[key]) acts.push({ c: 'post', n: postCount[key] });
  if (bmCount[key]) acts.push({ c: 'bookmark', n: bmCount[key] });
  const jt = track[key];
  if (jt?.applied) acts.push({ c: 'applied', n: jt.applied });
  if (jt?.interview) acts.push({ c: 'interview', n: 1 });
  if (jt?.project) acts.push({ c: 'project', n: 1 });
  if (jt?.study) acts.push({ c: 'study', n: 1 });
  return acts;
}
function cellStyle(acts: { c: string; n: number }[]) {
  if (!acts.length) return '';
  if (acts.length === 1) return `background:${CATS[acts[0].c].color}`;
  const seg = 100 / acts.length;
  const stops = acts
    .map((a, i) => `${CATS[a.c].color} ${(i * seg).toFixed(1)}% ${((i + 1) * seg).toFixed(1)}%`)
    .join(', ');
  return `background:linear-gradient(135deg, ${stops})`;
}
function cellTitle(key: string, acts: { c: string; n: number }[], lang: 'zh' | 'en') {
  if (!acts.length) return key;
  const jt = track[key];
  const parts = acts.map((a) => `${CATS[a.c][lang]}${a.n > 1 ? ' ×' + a.n : ''}`);
  if (jt?.replies) parts.push(`${lang === 'zh' ? '收到回复' : 'Replies'} ×${jt.replies}`);
  return `${key} · ${parts.join(' · ')}`;
}

const MONTHS_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// 显示窗口：2026-07-01 → 2026-10-31（求职冲刺期），之前的不显示，
// 今天之后的日子留成空格子，一眼看到还剩多少时间
const START = new Date(Date.UTC(2026, 6, 1));
const END = new Date(Date.UTC(2026, 9, 31));
const TODAY = new Date().toISOString().slice(0, 10);
const gridStart = new Date(START);
gridStart.setUTCDate(START.getUTCDate() - START.getUTCDay()); // 对齐到周日

const daysLeft = Math.max(
  0,
  Math.ceil((END.getTime() - Date.parse(TODAY)) / 86400000)
);

interface Cell { key: string; style: string; titleZh: string; titleEn: string; active: boolean; future: boolean; }
const weeks: (Cell | null)[][] = [];
const monthLabels: { zh: string; en: string }[] = [];
let cursor = new Date(gridStart);
let prevMonth = -1;
while (cursor <= END) {
  const week: (Cell | null)[] = [];
  const weekStartMonth = cursor.getUTCMonth();
  const inStart = cursor >= START;
  const isNewMonth = inStart && weekStartMonth !== prevMonth && cursor.getUTCDate() <= 7;
  monthLabels.push(
    isNewMonth ? { zh: `${weekStartMonth + 1}月`, en: MONTHS_EN[weekStartMonth] } : { zh: '', en: '' }
  );
  if (inStart) prevMonth = weekStartMonth;
  for (let i = 0; i < 7; i++) {
    const key = cursor.toISOString().slice(0, 10);
    if (cursor >= START && cursor <= END) {
      const future = key > TODAY;
      const acts = future ? [] : dayActivities(key);
      week.push({
        key,
        style: cellStyle(acts),
        titleZh: future ? key : cellTitle(key, acts, 'zh'),
        titleEn: future ? key : cellTitle(key, acts, 'en'),
        active: acts.length > 0,
        future,
      });
    } else {
      week.push(null);
    }
    cursor = new Date(cursor);
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
  weeks.push(week);
}
---

<Base active="home">
  <section class="hero">
    <p class="kicker">A personal corner of the internet</p>
    <h1>
      <span class="lang-zh">你好，我是 Eleanor</span><span class="lang-en">Hi, I'm Eleanor</span>
      <span class="wave">👋</span>
    </h1>
    <p class="lede lang-zh">
      这里是我在互联网上的自留地：记录人生轨迹，陈列想法与作品，发表我写的文章，也收藏我在网上遇到的好东西。
    </p>
    <p class="lede lang-en">
      This is my little plot of land on the internet — my journey, my ideas and works, my
      writing, and a library of great things I've found along the way.
    </p>
  </section>

  <div class="card-grid">
    <a class="card" href="/journey/">
      <span class="card-en lang-zh">Journey</span>
      <h2>🧭 <span class="lang-zh">轨迹</span><span class="lang-en">Journey</span></h2>
      <p class="lang-zh">一条有趣的性格叙事线：我从哪里来，绕了什么路，要到哪里去。</p>
      <p class="lang-en">A narrative with personality: where I came from, the detours I took, and where I'm headed.</p>
    </a>
    <a class="card" href="/works/">
      <span class="card-en lang-zh">Works & Ideas</span>
      <h2>🛠️ <span class="lang-zh">作品与想法</span><span class="lang-en">Works & Ideas</span></h2>
      <p class="lang-zh">做出来的东西，和还在脑子里冒泡的东西。</p>
      <p class="lang-en">Things I've built, and things still bubbling in my head.</p>
    </a>
    <a class="card" href="/writing/">
      <span class="card-en lang-zh">Writing</span>
      <h2>✍️ <span class="lang-zh">文章</span><span class="lang-en">Writing</span></h2>
      <p class="lang-zh">做自己的 journalist：想法成熟一个，就发表一个。</p>
      <p class="lang-en">Being my own journalist: one idea matures, one gets published.</p>
    </a>
    <a class="card" href="/library/">
      <span class="card-en lang-zh">Library</span>
      <h2>📚 <span class="lang-zh">收藏</span><span class="lang-en">Library</span></h2>
      <p class="lang-zh">互联网上的好文章值得一个家，按收藏夹分门别类。</p>
      <p class="lang-en">Great reads deserve a home — sorted into folders, each with a note.</p>
    </a>
  </div>

  <section class="activity">
    <h2>
      <span class="lang-zh">动态</span><span class="lang-en">Activity</span>
      <span class="activity-since">2026.07 — 2026.10</span>
    </h2>
    <p class="activity-hint">
      <span class="lang-zh">写文章、收藏、投简历、面试、做项目、学习——每一天的痕迹。距离 10 月底还有 {daysLeft} 天。</span>
      <span class="lang-en">Writing, bookmarks, applications, interviews, projects, learning — traces of each day. {daysLeft} days left until the end of October.</span>
    </p>
    <div class="activity-scroll">
      <div class="activity-months">
        {
          monthLabels.map((m) => (
            <span class="a-month-label">
              <span class="lang-zh">{m.zh}</span>
              <span class="lang-en">{m.en}</span>
            </span>
          ))
        }
      </div>
      <div class="activity-grid">
        {
          weeks.map((week) => (
            <div class="a-week">
              {week.map((c) =>
                c === null ? (
                  <span class="a-day a-void" />
                ) : (
                  <span
                    class:list={['a-day', c.future ? 'a-future' : !c.active && 'a-quiet', c.key === TODAY && 'a-today']}
                    style={c.style}
                    title={c.titleEn}
                    data-t-zh={c.titleZh}
                    data-t-en={c.titleEn}
                  />
                )
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div class="activity-legend">
      {
        Object.values(CATS).map((cat) => (
          <span class="a-legend-item">
            <i class="a-day" style={`background:${cat.color}`} />
            <span class="lang-zh">{cat.zh}</span>
            <span class="lang-en">{cat.en}</span>
          </span>
        ))
      }
    </div>
  </section>

  <section>
    <h2>
      {
        hasFeatured ? (
          <>
            <span class="lang-zh">精选文章</span><span class="lang-en">Featured writing</span>
          </>
        ) : (
          <>
            <span class="lang-zh">最新文章</span><span class="lang-en">Latest writing</span>
          </>
        )
      }
    </h2>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a class="post-title" href={`/writing/${post.id}/`}>{post.data.title}</a>
            <div class="post-meta">
              <span>{fmt(post.data.date)}</span>
              <span class="badge badge-lang">
                {post.data.lang === 'zh' ? (
                  <>
                    <span class="lang-zh">中文</span><span class="lang-en">CN</span>
                  </>
                ) : (
                  'EN'
                )}
              </span>
            </div>
            {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
