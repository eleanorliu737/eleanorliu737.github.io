---
import Base from '../layouts/Base.astro';
import folders from '../data/bookmarks.json';
---

<Base title="收藏 Library" active="library">
  <p class="kicker">04 · Library</p>
  <h1><span class="lang-zh">收藏</span><span class="lang-en">The Library</span></h1>
  <p class="lede lang-zh">互联网上的好文章不该只活在浏览器书签里。这里是我的公开收藏馆，按收藏夹分类，每条都附一句为什么值得读。</p>
  <p class="lede lang-en">Great things on the internet deserve better than a browser bookmark. Sorted into folders, each with a note on why it's worth your time.</p>

  {
    folders.map((f) => (
      <section class="folder">
        <h2>
          {f.emoji}
          <span class="lang-zh">{f.name}</span>
          <span class="lang-en">{f.nameEn}</span>
        </h2>
        <p class="folder-blurb lang-zh">{f.blurb}</p>
        <p class="folder-blurb lang-en">{f.blurbEn}</p>
        <ul class="bookmark-list">
          {f.items.map((b) => (
            <li>
              <a href={b.url} target="_blank" rel="noopener">{b.title}</a>
              <span class="bookmark-source">{b.source}</span>
              {b.note && <p class="bookmark-note">{b.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
