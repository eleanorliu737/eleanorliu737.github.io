      $('btn-bm-add').addEventListener('click', async () => {
        const msg = $('bm-msg');
        const title = $('bm-title').value.trim();
        let url = $('bm-url').value.trim();
        if (!title) return (msg.textContent = '请填一下文章标题');
        if (!url) return (msg.textContent = '请把文章网址贴进来');
        if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
        let source = '';
        try { source = new URL(url).hostname.replace(/^www\./, ''); } catch (e) { return (msg.textContent = '这个网址好像不对，检查一下？'); }

        let folder;
        if ($('bm-folder').value === '_new') {
          const name = $('bm-nf-name').value.trim();
          if (!name) return (msg.textContent = '请给新收藏夹起个名字');
          folder = {
            emoji: $('bm-nf-emoji').value.trim() || '🔖',
            name,
            nameEn: name,
            blurb: $('bm-nf-blurb').value.trim(),
            blurbEn: $('bm-nf-blurb').value.trim(),
            items: [],
          };
          state.bookmarks.data.push(folder);
        } else {
          folder = state.bookmarks.data[Number($('bm-folder').value)];
        }
        folder.items.unshift({ title, url, source, note: $('bm-note').value.trim() });
        msg.textContent = '发布中…';
        $('btn-bm-add').disabled = true;
        try {
          await saveBookmarks('Add bookmark: ' + title);
          renderBookmarks();
          $('bm-title').value = '';
          $('bm-url').value = '';
          $('bm-note').value = '';
          $('bm-nf-name').value = '';
          $('bm-nf-blurb').value = '';
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
        $('btn-bm-add').disabled = false;
      });
      async function removeBookmark(fi, ii, title) {
        if (!confirm(`确定删除收藏「${title}」吗？`)) return;
        state.bookmarks.data[fi].items.splice(ii, 1);
        const msg = $('bm-msg');
        msg.textContent = '删除中…';
        try {
          await saveBookmarks('Remove bookmark: ' + title);
          renderBookmarks();
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
      }

      // ============================================================
      // 🧭 轨迹
      // ============================================================
      const JO_FIELDS = [
        ['period', '时间段（例：2026 · 现在 Now）'],
        ['emoji', '图标（一个 emoji）', { narrow: true }],
        ['title', '章节标题 · 中文'],
        ['titleEn', '章节标题 · 英文'],
        ['tagline', '性格关键词 · 中文（例：「想法不值钱，做出来才算」）'],
        ['taglineEn', '性格关键词 · 英文'],
        ['body', '这一章的故事 · 中文', { textarea: true }],
        ['bodyEn', '这一章的故事 · 英文', { textarea: true }],
      ];
      async function loadJourney() {
        const file = await getFile('src/data/journey.json');
        state.journey = { sha: file.sha, data: JSON.parse(file.text) };
        renderJourney();
      }
      function markDirty(which) {
        state.dirty[which] = true;
        const btn = which === 'journey' ? $('btn-jo-save') : $('btn-wk-save');
        btn.textContent = (which === 'journey' ? '发布轨迹页的修改' : '发布作品页的修改') + '（有未发布的改动）';
      }
      function itemCard(titleText, obj, fields, which, onDelete) {
        const card = el('div', 'item-card');
        const head = el('div', 'item-card-head');
        head.appendChild(el('span', 'item-card-title', titleText));
        const del = el('button', 'del-btn', '✕ 删除');
        del.type = 'button';
        del.addEventListener('click', onDelete);
        head.appendChild(del);
        card.appendChild(head);
        let pendingRow = [];
        fields.forEach(([key, label, opts = {}]) => {
          const f = field(label, obj[key], (v) => { obj[key] = v; markDirty(which); }, opts);
          if (opts.narrow && pendingRow.length === 0) {
            pendingRow.push(f);
          } else if (pendingRow.length) {
            card.appendChild(row(...pendingRow, f));
            pendingRow = [];
          } else {
            card.appendChild(f);
          }
        });
        pendingRow.forEach((f) => card.appendChild(f));
        return card;
      }
      function renderJourney() {
        const box = $('jo-list');
        box.innerHTML = '';
        state.journey.data.forEach((ch, i) => {
          box.appendChild(
            itemCard(`第 ${i + 1} 章`, ch, JO_FIELDS, 'journey', () => {
              if (!confirm(`确定删除「${ch.title || '这一章'}」吗？（删除后仍需点发布才生效）`)) return;
              state.journey.data.splice(i, 1);
              markDirty('journey');
              renderJourney();
            })
          );
        });
      }
      $('btn-jo-add').addEventListener('click', () => {
        state.journey.data.push({ period: '', emoji: '✨', title: '', titleEn: '', tagline: '', taglineEn: '', body: '', bodyEn: '' });
        markDirty('journey');
        renderJourney();
      });
      $('btn-jo-save').addEventListener('click', async () => {
        const msg = $('jo-msg');
        msg.textContent = '发布中…';
        $('btn-jo-save').disabled = true;
        try {
          state.journey.sha = await putFile('src/data/journey.json', JSON.stringify(state.journey.data, null, 2) + '\n', 'Update journey page', state.journey.sha);
          state.dirty.journey = false;
          $('btn-jo-save').textContent = '发布轨迹页的修改';
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
        $('btn-jo-save').disabled = false;
      });

      // ============================================================
      // 🛠 作品与想法
      // ============================================================
      const WK_P_FIELDS = [
        ['emoji', '图标（一个 emoji）', { narrow: true }],
        ['name', '作品名 · 中文'],
        ['nameEn', '作品名 · 英文'],
        ['desc', '介绍 · 中文', { textarea: true }],
        ['descEn', '介绍 · 英文', { textarea: true }],
        ['stackText', '用到的技术（用逗号分开，例：Python, RAG）'],
        ['link', '链接（作品的网址或 GitHub 地址）'],
        ['status', '状态 · 中文（例：✅ 已完成）'],
        ['statusEn', '状态 · 英文'],
      ];
      const WK_I_FIELDS = [
        ['emoji', '图标（一个 emoji）', { narrow: true }],
        ['text', '想法 · 中文'],
        ['textEn', '想法 · 英文'],
      ];
      async function loadWorks() {
        const file = await getFile('src/data/projects.json');
        state.works = { sha: file.sha, data: JSON.parse(file.text) };
        state.works.data.projects.forEach((p) => (p.stackText = (p.stack || []).join(', ')));
        renderWorks();
      }
      function renderWorks() {
        const pBox = $('wk-projects');
        pBox.innerHTML = '';
        state.works.data.projects.forEach((p, i) => {
          pBox.appendChild(
            itemCard(`作品 ${i + 1}`, p, WK_P_FIELDS, 'works', () => {
              if (!confirm(`确定删除作品「${p.name || ''}」吗？（删除后仍需点发布才生效）`)) return;
              state.works.data.projects.splice(i, 1);
              markDirty('works');
              renderWorks();
            })
          );
        });
        const iBox = $('wk-ideas');
        iBox.innerHTML = '';
        state.works.data.ideas.forEach((idea, i) => {
          iBox.appendChild(
            itemCard(`想法 ${i + 1}`, idea, WK_I_FIELDS, 'works', () => {
              if (!confirm('确定删除这个想法吗？（删除后仍需点发布才生效）')) return;
              state.works.data.ideas.splice(i, 1);
              markDirty('works');
              renderWorks();
            })
          );
        });
      }
      $('btn-wk-addp').addEventListener('click', () => {
        state.works.data.projects.push({ emoji: '🛠', name: '', nameEn: '', desc: '', descEn: '', stack: [], stackText: '', link: '', status: '🚧 进行中', statusEn: '🚧 In progress' });
        markDirty('works');
        renderWorks();
      });
      $('btn-wk-addi').addEventListener('click', () => {
        state.works.data.ideas.push({ emoji: '💡', text: '', textEn: '' });
        markDirty('works');
        renderWorks();
      });
      $('btn-wk-save').addEventListener('click', async () => {
        const msg = $('wk-msg');
        msg.textContent = '发布中…';
        $('btn-wk-save').disabled = true;
        try {
          const clean = {
            projects: state.works.data.projects.map((p) => ({
              emoji: p.emoji, name: p.name, nameEn: p.nameEn, desc: p.desc, descEn: p.descEn,
              stack: (p.stackText || '').split(/[,，]/).map((s) => s.trim()).filter(Boolean),
              link: p.link, status: p.status, statusEn: p.statusEn,
            })),
            ideas: state.works.data.ideas.map((i) => ({ emoji: i.emoji, text: i.text, textEn: i.textEn })),
          };
          state.works.sha = await putFile('src/data/projects.json', JSON.stringify(clean, null, 2) + '\n', 'Update works page', state.works.sha);
          state.dirty.works = false;
          $('btn-wk-save').textContent = '发布作品页的修改';
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
        $('btn-wk-save').disabled = false;
      });

      // ============================================================
      // 🎯 求职打卡
      // ============================================================
      async function loadJobtrack() {
        const file = await getFile('src/data/jobtrack.json');
        state.jobtrack = { sha: file.sha, data: JSON.parse(file.text) };
        $('jt-date').value = today();
        renderJobtrack();
      }
      function renderJobtrack() {
        const list = $('jt-list');
        list.innerHTML = '';
        const entries = Object.entries(state.jobtrack.data).sort((a, b) => b[0].localeCompare(a[0]));
        if (!entries.length) list.appendChild(el('li', 'bm-item-note', '还没有记录，从上面开始第一天的打卡吧 💪'));
        entries.forEach(([date, rec]) => {
          const li = el('li');
          const btn = el('button', 'file-btn', `${date} · 投 ${rec.applied} · 回复 ${rec.replies} · 面试 ${rec.interview ? '✅' : '—'}`);
          btn.type = 'button';
          btn.style.width = 'auto';
          btn.addEventListener('click', () => {
            $('jt-date').value = date;
            $('jt-applied').value = rec.applied;
            $('jt-replies').value = rec.replies;
            $('jt-interview').checked = !!rec.interview;
          });
          li.appendChild(btn);
          const del = el('button', 'del-btn', '✕');
          del.type = 'button';
          del.addEventListener('click', async () => {
            if (!confirm(`删除 ${date} 的记录？`)) return;
            delete state.jobtrack.data[date];
            await saveJobtrack(`Remove job tracking for ${date}`);
          });
          li.appendChild(del);
          list.appendChild(li);
        });
      }
      async function saveJobtrack(message) {
        const msg = $('jt-msg');
        msg.textContent = '发布中…';
        try {
          state.jobtrack.sha = await putFile(
            'src/data/jobtrack.json',
            JSON.stringify(state.jobtrack.data, null, 2) + '\n',
            message,
            state.jobtrack.sha
          );
          renderJobtrack();
          msg.textContent = OK_MSG;
        } catch (e) {
          msg.textContent = '❌ ' + e.message;
        }
      }
      $('btn-jt-save').addEventListener('click', async () => {
        const date = $('jt-date').value;
        if (!date) return ($('jt-msg').textContent = '请选择日期');
        const applied = Math.max(0, Number($('jt-applied').value) || 0);
        const replies = Math.max(0, Number($('jt-replies').value) || 0);
        const interview = $('jt-interview').checked;
        if (!applied && !replies && !interview) {
          delete state.jobtrack.data[date];
        } else {
          state.jobtrack.data[date] = { applied, replies, interview };
        }
        $('btn-jt-save').disabled = true;
        await saveJobtrack(`Job tracking: ${date}`);
        $('btn-jt-save').disabled = false;
      });

      init();
    </script>
  </body>
</html>
